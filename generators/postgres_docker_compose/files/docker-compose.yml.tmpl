name: {{.ProjectName}}

services:
  postgres:
    image: postgres:16-alpine
    container_name: {{.ProjectName}}-db
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{.ProjectName}}
    ports:
      - "{{.DBPort}}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
